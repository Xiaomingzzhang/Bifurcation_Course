           RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", 
          RowBox[{"xRange", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", 
          RowBox[{"xRange", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", 
        RowBox[{"ContourStyle", "->", 
         RowBox[{"{", 
          RowBox[{"Red", ",", "Dashed", ",", 
           RowBox[{"Thickness", "[", "0.005", "]"}]}], "}"}]}], ",", 
        RowBox[{"RegionFunction", "->", 
         RowBox[{"Function", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"mVal", ",", "xVal", ",", "z"}], "}"}], ",", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"dfdx", "/.", " ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"mu", "->", "mVal"}], ",", 
                RowBox[{"x", "->", "xVal"}]}], "}"}]}], ")"}], ">", "0"}]}], 
          "]"}]}], ",", 
        RowBox[{"PlotPoints", "->", "50"}], ",", 
