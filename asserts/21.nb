Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "PlotBifurcation", "]"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"PlotBifurcation", "[", 
   RowBox[{
   "f_", ",", "x_Symbol", ",", "mu_Symbol", ",", "muRange_List", ",", 
    "xRange_List", ",", "label_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"dfdx", ",", "stablePlot", ",", "unstablePlot"}], "}"}], ",", 
    RowBox[{"(*", 
     RowBox[{"1.", " ", "\:8ba1\:7b97\:5bfc\:6570"}], "*)"}], 
    RowBox[{
     RowBox[{"dfdx", "=", 
      RowBox[{"D", "[", 
       RowBox[{"f", ",", "x"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"2.", " ", "\:7ed8\:5236\:7a33\:5b9a\:5206\:652f", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"df", "/", "dx"}], "<", "0"}], ")"}]}], "*)"}], 
     RowBox[{"stablePlot", "=", 
      RowBox[{"ContourPlot", "[", 
       RowBox[{
        RowBox[{"f", "==", "0"}], ",", 
        RowBox[{"{", 
         RowBox[{"mu", ",", 
          RowBox[{"muRange", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", 
          RowBox[{"muRange", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", 
          RowBox[{"xRange", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", 
          RowBox[{"xRange", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", 
        RowBox[{"ContourStyle", "->", 
         RowBox[{"{", 
          RowBox[{"Blue", ",", 
           RowBox[{"Thickness", "[", "0.005", "]"}]}], "}"}]}], ",", 
        RowBox[{
        "(*", "\:4f7f\:7528\:66ff\:6362\:786e\:4fdd\:8ba1\:7b97\:6b63\:786e", 
         "*)"}], 
        RowBox[{"RegionFunction", "->", 
         RowBox[{"Function", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"mVal", ",", "xVal", ",", "z"}], "}"}], ",", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"dfdx", "/.", " ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"mu", "->", "mVal"}], ",", 
                RowBox[{"x", "->", "xVal"}]}], "}"}]}], ")"}], "<", "0"}]}], 
          "]"}]}], ",", 
        RowBox[{"PlotPoints", "->", "50"}], ",", 
        RowBox[{"MaxRecursion", "->", "3"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"3.", " ", "\:7ed8\:5236\:4e0d\:7a33\:5b9a\:5206\:652f", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"df", "/", "dx"}], ">", "0"}], ")"}]}], "*)"}], 
     RowBox[{"unstablePlot", "=", 
      RowBox[{"ContourPlot", "[", 
       RowBox[{
        RowBox[{"f", "==", "0"}], ",", 
        RowBox[{"{", 
         RowBox[{"mu", ",", 
          RowBox[{"muRange", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", 
